# Copy to .env and fill in. Do not commit .env.
# The backend loads this from the project root (see backend/load-env.ts).

# Required for Design & renovate advisor and Furniture preview (Google Gemini via OpenAI-compatible endpoint).
GEMINI_API_KEY=AIza...

# Optional: override endpoint/model defaults.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_CHAT_MODEL=gemini-3.1-pro-preview
# GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# Optional. Defaults to 3000. Same port serves API and frontend after build.
PORT=3000
